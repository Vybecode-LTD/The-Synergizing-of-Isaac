# The web app, API, data and scripts are built on Linux (Docker, CI): keep them LF everywhere.
# The legacy desktop app under src/ keeps whatever git's defaults give it.
web/**      text=auto eol=lf
api/**      text=auto eol=lf
data/**     text=auto eol=lf
scripts/**  text=auto eol=lf
docs/**     text=auto eol=lf
*.png       binary
*.webp      binary
